# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Optional Proxy Authentication
# PROXY_API_KEY=your-proxy-auth-key

# Declarative JSON configuration (optional; overrides env providers when present)
# Default path: config/7proxy.json (see config/7proxy.example.json; the working
# config is git-ignored - commit only the example).
#SEVEN_PROXY_CONFIG=/path/to/7proxy.json
# API keys for file-configured providers come from environment variables
# referenced by name inside the file, e.g.:
# DATACENTER1_KEY_1=your-upstream-key-1
# DATACENTER1_KEY_2=your-upstream-key-2
# Env-only mode: disable implicit owner-first cross-provider failover (rarely needed):
#ENFORCE_EXPLICIT_GROUPS=true
# Allow plain-HTTP upstreams for localhost/private development:
#ALLOW_INSECURE_UPSTREAM=true

# Logging
LOG_LEVEL=info

# Request Limits
MAX_REQUEST_BODY_SIZE=1048576
REQUEST_TIMEOUT_MS=60000
STREAM_TIMEOUT_MS=300000
# Hard cap per streaming exchange (0 disables)
STREAM_OVERALL_TIMEOUT_MS=300000

# Provider: Anthropic Example (native Messages + native token counting)
ANTHROPIC_API_KEYS=sk-ant-your-key-1,sk-ant-your-key-2
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODELS=claude-sonnet-4,claude-haiku-4
#
# Anthropic capabilities:
#   anthropicMessages=native|translated  - Messages API mode
#   anthropicTokenCount=native           - exact token counting (never estimated)
#   thinking=true                        - extended thinking blocks/field
#   documents=true                       - document (PDF) blocks
#   betas=true                           - forward anthropic-beta header
#   anthropicVersion=YYYY-MM-DD          - version sent upstream (default 2023-06-01)
#   messagesPath=/v1/messages            - native endpoint override
#   countTokensPath=/v1/messages/count_tokens - token-count endpoint override
#ANTHROPIC_CAPABILITIES=anthropicMessages=native,anthropicTokenCount=native,thinking=true

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000
KEY_COOLDOWN_MS=60000

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,POST,OPTIONS

# Provider: OpenAI Example
# Comma-separated list of API keys for rotation
OPENAI_API_KEYS=sk-your-key-1,sk-your-key-2
OPENAI_BASE_URL=https://api.openai.com
#
# Capabilities (optional): comma-separated key=value pairs.
#   responses=native|translated|unsupported  - Responses API mode
#   reasoning=true|false                     - upstream accepts reasoning params
#   previousResponseId=true|false            - native previous_response_id support
#OPENAI_CAPABILITIES=responses=native,reasoning=true,previousResponseId=true

# Provider: Anthropic Example (optional)
# ANTHROPIC_API_KEYS=sk-ant-your-key-1,sk-ant-your-key-2
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default Provider
DEFAULT_PROVIDER=openai

# Anthropic-translated example: an OpenAI-compatible upstream serving
# /v1/messages via translation:
# OPENAI_CAPABILITIES=anthropicMessages=translated
#
# Cross-provider failover: same models on both providers so Anthropic requests
# fall back from a translated primary to a native Anthropic provider:
# OPENAI_MODELS=claude-sonnet-4,gpt-4o
# OPENAI_CAPABILITIES=anthropicMessages=translated
# ANTHROPIC_API_KEYS=sk-ant-your-key-1
# ANTHROPIC_MODELS=claude-sonnet-4
# ANTHROPIC_CAPABILITIES=anthropicMessages=native,anthropicTokenCount=native
