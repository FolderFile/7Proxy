# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Optional Proxy Authentication
# PROXY_API_KEY=your-proxy-auth-key

# Logging
LOG_LEVEL=info

# Request Limits
MAX_REQUEST_BODY_SIZE=1048576
REQUEST_TIMEOUT_MS=60000
STREAM_TIMEOUT_MS=300000
# Hard cap per streaming exchange (0 disables)
STREAM_OVERALL_TIMEOUT_MS=300000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000
KEY_COOLDOWN_MS=60000

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,POST,OPTIONS

# Provider: OpenAI Example
# Comma-separated list of API keys for rotation
OPENAI_API_KEYS=sk-your-key-1,sk-your-key-2
OPENAI_BASE_URL=https://api.openai.com
#
# Capabilities (optional): comma-separated key=value pairs.
#   responses=native|translated|unsupported  - Responses API mode
#   reasoning=true|false                     - upstream accepts reasoning params
#   previousResponseId=true|false            - native previous_response_id support
#OPENAI_CAPABILITIES=responses=native,reasoning=true,previousResponseId=true

# Provider: Anthropic Example (optional)
# ANTHROPIC_API_KEYS=sk-ant-your-key-1,sk-ant-your-key-2
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default Provider
DEFAULT_PROVIDER=openai
